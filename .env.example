# Copy to .env.local for local admin dashboard development.
# Use only the public Supabase anon/publishable key in the browser.
# Never put a service-role key in a VITE_* variable.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
VITE_SHIFT_AUTH_REDIRECT=dkasu-shift://auth/callback
